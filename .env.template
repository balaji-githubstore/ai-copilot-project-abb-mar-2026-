# Environment variables template for the Selenium pytest framework
# Copy this file to .env and update values for your environment

# Environment Selection
TEST_ENV=dev                          # dev, staging, prod

# Database Configuration
DB_USER=test_user
DB_PASSWORD=your_secure_password_here

# API Configuration  
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Test User Credentials
TEST_PASSWORD=test123456
ADMIN_PASSWORD=admin123456

# Optional: Override specific settings
# BROWSER=chrome                      # chrome, firefox
# HEADLESS=false                      # true, false
# BASE_URL=http://localhost:3000      # Override base URL

# CI/CD Integration
# TEST_WORKER_COUNT=4                 # Number of parallel workers
# SCREENSHOT_ON_FAILURE=true          # Capture screenshots on test failures
# VIDEO_RECORDING=false               # Record test execution videos (future feature)

# Logging Configuration
# LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR
# LOG_TO_FILE=true                    # Enable file logging
# LOG_TO_CONSOLE=true                 # Enable console logging

# Security
# MASK_SENSITIVE_DATA=true            # Mask passwords in logs and reports